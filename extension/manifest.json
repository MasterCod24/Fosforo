{
  "manifest_version": 3,
  "name": "Fosforo",
  "version": "2.6.0",
  "description": "Ricorda cosa guardi e ti dice cosa guardare stasera. I tuoi dati restano sul tuo Mac.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.themoviedb.org/*",
    "https://image.tmdb.org/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/overlay.js",
        "content/detect.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Fosforo",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "pages/dashboard.html#impostazioni",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*.woff2",
        "content/overlay.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
